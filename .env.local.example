NEXT_PUBLIC_APP_URL=http://localhost:3000

# PDS management API (include the /api/v1 prefix, e.g. https://your-backend.url/api/v1)
PDS_API_BASE_URL=https://your-backend.url/api/v1
PDS_API_TOKEN=your_token_here
NEXT_PUBLIC_PDS_HOSTNAME_SUFFIX=.eny.space

# PDS post-subscription lifecycle (grace -> suspended -> deleted)
# Gate the destructive Froxlor calls (termination/reactivation). Off = log only.
PDS_LIFECYCLE_ENABLED=false
# Length of one lifecycle "unit" in ms. Default 86400000 (1 day).
# Set to 60000 (1 minute) in dev to compress 14/30/30 days into minutes.
# PDS_LIFECYCLE_UNIT_MS=60000
# Secret for the lifecycle cron endpoint (/api/cron/pds-lifecycle).
CRON_SECRET=change_me

# Stripe keys
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_12345
STRIPE_SECRET_KEY=sk_12345
STRIPE_PAYMENT_DESCRIPTION='Something descriptive'
# https://stripe.com/docs/webhooks/signatures
STRIPE_WEBHOOK_SECRET=whsec_1234

# Supabase keys
NEXT_PUBLIC_SUPABASE_URL=https://randomhash.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_random-hash
NEXT_PUBLIC_SUPABASE_ANON_KEY=anonkey
SUPABASE_SERVICE_ROLE_KEY=somekey

# https://dashboard.stripe.com/ 
NEXT_PUBLIC_STRIPE_PRICE_ID=price_randomhash

# Optional: plan-specific Stripe Price IDs (recommended). Keys match package names.
# If provided, the UI will show amounts from Stripe and checkout will use the correct Price per plan.
NEXT_PUBLIC_STRIPE_PRICE_PERSONAL_ID=price_randomhash_personal
NEXT_PUBLIC_STRIPE_PRICE_COMMUNITY_ID=price_randomhash_community
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_ID=price_randomhash_business